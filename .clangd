CompileFlags:
  # Generated by cmakes/CompileCommands.cmake (the Visual Studio
  # generator does not export compile commands natively)
  CompilationDatabase: build-msvc-debug

Diagnostics:
  Suppress:
    - unknown-warning-option
  ClangTidy:
    Add:
      - bugprone-*
      - performance-*
    CheckOptions:
      readability-identifier-naming.IgnoreFailedSplit: true

Hover:
  ShowAKA: On

InlayHints:
  Enabled: false
